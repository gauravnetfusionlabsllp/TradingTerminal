# === Core ===
DATABASE_URL="file:./prisma/prod.db"
PORT=3001
SCRAPE_INTERVAL_MINUTES=10

# === News Data Source ===
# URL to the news API endpoint. Leave empty to disable scraping.
# The API should return articles with analysis/recommendations.
NEWS_API_URL=""
NEWS_API_KEY=""

# === AI / LLM Provider ===
# Any OpenAI-compatible API endpoint (OpenAI, Gemini, local Ollama, etc.)
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_MODEL="gemini-2.0-flash"

# === MT5 Bridge (login + trading, required) ===
MT5_BRIDGE_URL="http://localhost:5050"
MT5_BRIDGE_API_KEY=""

# === Realtime market feed (Python FXCubic FIX bridge WebSocket) ===
# Same host: ws://localhost:8765 — otherwise wss://newapi.sgfx.com/ws. Empty disables (REST polling only).
MARKET_FEED_URL="ws://localhost:8765"

# === JWT (required in production) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# === Client → API (optional) ===
# The client calls the API directly (no Vite proxy). Defaults: dev → http://localhost:3001, production build →
# same origin (the server serves the client). Set only if the API runs elsewhere, e.g. another port or host.
VITE_API_URL=""

# === WalletConnect (optional, for Web3 wallet connection) ===
VITE_WALLETCONNECT_PROJECT_ID=""

# === Billing (Stripe, optional) ===
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# === Encryption (required for Alpaca credential storage) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# === CORS (production) ===
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS=""

# === GCS Backup (optional) ===
GCS_BUCKET=""
GCS_BACKUP_INTERVAL_MINUTES=5
