generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StockQuote {
  id              Int      @id @default(autoincrement())
  symbol          String   @unique
  name            String?
  price           Float
  change          Float?
  changePercent   Float?
  volume          BigInt?
  marketCap       Float?
  dayHigh         Float?
  dayLow          Float?
  previousClose   Float?

  updatedAt DateTime @updatedAt
}

model TrackedStock {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  name      String?
  source    String   @default("default") // default, ai-recommended
  addedAt   DateTime @default(now())

  @@index([source])
}

// ── Pro Trading Features (v0.7.0) ──

model EconomicEvent {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  event      String
  country    String
  date       DateTime
  impact     String   // high, medium, low
  actual     String?
  previous   String?
  estimate   String?
  released   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([country])
  @@index([impact])
  @@index([released, date])
}

model Alert {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation("userAlerts", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // price_cross, price_change_pct, sentiment_shift, news_keyword, volume_spike
  symbol    String?
  condition String   // JSON: { threshold, direction, keyword, etc. }
  enabled   Boolean  @default(true)
  triggers  AlertTrigger[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([symbol])
  @@index([enabled])
  @@index([userId])
}

model AlertTrigger {
  id        Int      @id @default(autoincrement())
  alertId   Int
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  message   String
  value     String?  // The value that triggered (e.g. price)
  createdAt DateTime @default(now())

  @@index([alertId])
}

model InsiderTrade {
  id              Int      @id @default(autoincrement())
  symbol          String
  filingDate      DateTime
  tradeDate       DateTime
  ownerName       String
  ownerTitle      String?
  transactionType String   // P (Purchase), S (Sale)
  shares          Float
  pricePerShare   Float?
  totalValue      Float?
  sharesOwned     Float?
  secFilingUrl    String?
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([filingDate])
  @@index([transactionType])
  @@index([symbol, filingDate])
}

// ── Users (one row per MT5 login) ──

model User {
  id        Int      @id @default(autoincrement())
  mt5Login  String?  @unique // MT5 logins are ulong — stored as text
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  alerts    Alert[]  @relation("userAlerts")
}
