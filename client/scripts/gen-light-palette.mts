// Writes src/styles/light-palette.css: Tailwind's palette mirrored for the light theme, so the dark-first
// panels (text-green-400, bg-zinc-900, border-zinc-800…) read correctly on white. Run: npx tsx scripts/gen-light-palette.mts
import { readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';

const theme = readFileSync(createRequire(import.meta.url).resolve('tailwindcss/theme.css'), 'utf8');
const shades = new Map<string, Map<string, string>>();
for (const [, hue, shade, value] of theme.matchAll(/--color-([a-z]+)-(\d+):\s*([^;]+);/g)) {
  if (!shades.has(hue)) shades.set(hue, new Map());
  shades.get(hue)!.set(shade, value.trim());
}

// Light shades turn dark (text stays AA on white), dark tints turn light; 300/400 lean darker since they are mostly text
const MIRROR: Record<string, string> = {
  50: '950', 100: '900', 200: '800', 300: '800', 400: '700', 500: '600', 600: '400', 700: '300', 800: '200', 900: '100', 950: '50',
};

let out = '/* Generated by scripts/gen-light-palette.mts — do not edit.\n'
  + '   The panels were written dark-first; in light mode each palette shade mirrors to its opposite.\n'
  + '   New code should use the semantic tokens (fg, neutral, panel, raised, border…) instead. */\n'
  + '[data-theme="light"] {\n';
for (const [hue, m] of shades) {
  for (const [shade, to] of Object.entries(MIRROR)) {
    const v = m.get(to);
    if (m.has(shade) && v) out += `  --color-${hue}-${shade}: ${v};\n`;
  }
}
writeFileSync(new URL('../src/styles/light-palette.css', import.meta.url), out + '}\n');
console.log(`light-palette.css: ${shades.size} hues`);
